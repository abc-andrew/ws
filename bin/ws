#!/usr/bin/env python3
"""Launcher for the ``ws`` recursive workspace forking CLI.

This file is commonly installed as a symlink (``~/.local/bin/ws`` -> this path).
It resolves its own real location so the sibling ``wsforge`` package can be imported
regardless of where the symlink lives, then dispatches to the CLI.
"""
from __future__ import annotations

import sys
from pathlib import Path

_repo_root = Path(__file__).resolve().parent.parent
if str(_repo_root) not in sys.path:
    sys.path.insert(0, str(_repo_root))

from wsforge.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
